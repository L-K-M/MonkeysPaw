# One identity string: the D-Bus name, this basename and StartupWMClass must
# all match AppIdentity.linuxAppID or activation and single-instance handling break.
[Desktop Entry]
Type=Application
Name=Monkey's Paw
GenericName=Prompt Repository
Comment=Pick a prompt and fill its placeholders
Exec=monkeyspaw
Icon=ch.lkmc.monkeyspaw
Terminal=false
Categories=Utility;
StartupWMClass=ch.lkmc.monkeyspaw
DBusActivatable=true
Actions=toggle;
# Version 1.5 is rejected outright by Ubuntu's desktop-file-validate; 1.4 is the
# highest that passes.
Version=1.4

# With D-Bus activation, this identifier is the GSimpleAction name exactly.
# Exec is the fallback for launchers without D-Bus activation support.
[Desktop Action toggle]
Name=Toggle Panel
Exec=gapplication action ch.lkmc.monkeyspaw toggle
