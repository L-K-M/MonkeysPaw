{
  "$id" : "https://lkmc.ch/monkeyspaw/sync-api/schema/ScopeIdentity.json",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "oneOf" : [
    {
      "additionalProperties" : false,
      "properties" : {
        "key" : {
          "minLength" : 0,
          "pattern" : "^(?:^user:[0-7][0-9A-HJKMNP-TV-Z]{25}$)(?![\\s\\S])",
          "type" : "string"
        },
        "kind" : {
          "const" : "user",
          "minLength" : 0,
          "type" : "string"
        }
      },
      "required" : [
        "key",
        "kind"
      ],
      "type" : "object"
    },
    {
      "additionalProperties" : false,
      "properties" : {
        "group_id" : {
          "format" : "ulid",
          "minLength" : 0,
          "pattern" : "^(?:[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])",
          "type" : "string"
        },
        "key" : {
          "format" : "scope-key",
          "minLength" : 0,
          "pattern" : "^(?:(user|group):[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])",
          "type" : "string"
        },
        "kind" : {
          "const" : "group",
          "minLength" : 0,
          "type" : "string"
        },
        "name" : {
          "maxLength" : 255,
          "minLength" : 1,
          "type" : "string"
        },
        "role" : {
          "$ref" : "Role.json"
        }
      },
      "required" : [
        "group_id",
        "key",
        "kind",
        "name",
        "role"
      ],
      "type" : "object",
      "x-syncapi-rules" : [
        "group-scope-key"
      ]
    }
  ],
  "title" : "ScopeIdentity"
}
