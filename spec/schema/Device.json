{
  "$id" : "https://lkmc.ch/monkeyspaw/sync-api/schema/Device.json",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "properties" : {
    "created_at" : {
      "format" : "date-time",
      "pattern" : "^(?:(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z)(?![\\s\\S])",
      "type" : "string",
      "x-syncapi-format" : "utc-milliseconds"
    },
    "id" : {
      "format" : "ulid",
      "pattern" : "^(?:[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])",
      "type" : "string"
    },
    "is_current" : {
      "type" : "boolean"
    },
    "last_seen_at" : {
      "oneOf" : [
        {
          "type" : "null"
        },
        {
          "format" : "date-time",
          "pattern" : "^(?:(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z)(?![\\s\\S])",
          "type" : "string",
          "x-syncapi-format" : "utc-milliseconds"
        }
      ]
    },
    "name" : {
      "maxLength" : 255,
      "minLength" : 1,
      "type" : "string"
    },
    "revoked_at" : {
      "oneOf" : [
        {
          "type" : "null"
        },
        {
          "format" : "date-time",
          "pattern" : "^(?:(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z)(?![\\s\\S])",
          "type" : "string",
          "x-syncapi-format" : "utc-milliseconds"
        }
      ]
    }
  },
  "required" : [
    "created_at",
    "id",
    "is_current",
    "last_seen_at",
    "name",
    "revoked_at"
  ],
  "title" : "Device",
  "type" : "object"
}
