{
  "$id" : "https://lkmc.ch/monkeyspaw/sync-api/schema/ExistingPrompt.json",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "properties" : {
    "content" : {
      "maxLength" : 262144,
      "type" : "string",
      "x-max-utf8-bytes" : 262144
    },
    "id" : {
      "format" : "ulid",
      "pattern" : "^(?:[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])",
      "type" : "string"
    },
    "rev" : {
      "maximum" : 9223372036854775807,
      "minimum" : 1,
      "type" : "integer"
    }
  },
  "required" : [
    "content",
    "id",
    "rev"
  ],
  "title" : "ExistingPrompt",
  "type" : "object"
}
