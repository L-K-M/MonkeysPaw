{
  "$id" : "https://lkmc.ch/monkeyspaw/sync-api/schema/ProviderSettingsDocument.json",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "properties" : {
    "document" : {
      "oneOf" : [
        {
          "type" : "null"
        },
        {
          "maxLength" : 349600,
          "minLength" : 1,
          "pattern" : "^(?:[A-Za-z0-9_-]+)(?![\\s\\S])",
          "type" : "string"
        }
      ]
    },
    "rev" : {
      "maximum" : 9223372036854775807,
      "minimum" : 0,
      "type" : "integer"
    },
    "updated_at" : {
      "oneOf" : [
        {
          "type" : "null"
        },
        {
          "format" : "date-time",
          "pattern" : "^(?:(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z)(?![\\s\\S])",
          "type" : "string",
          "x-syncapi-format" : "utc-milliseconds"
        }
      ]
    }
  },
  "required" : [
    "document",
    "rev",
    "updated_at"
  ],
  "title" : "ProviderSettingsDocument",
  "type" : "object"
}
