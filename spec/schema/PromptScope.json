{
  "$id" : "https://lkmc.ch/monkeyspaw/sync-api/schema/PromptScope.json",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "oneOf" : [
    {
      "additionalProperties" : false,
      "properties" : {
        "scope" : {
          "const" : "user",
          "minLength" : 0,
          "type" : "string"
        }
      },
      "required" : [
        "scope"
      ],
      "type" : "object"
    },
    {
      "additionalProperties" : false,
      "properties" : {
        "group_id" : {
          "format" : "ulid",
          "minLength" : 0,
          "pattern" : "^(?:[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])",
          "type" : "string"
        },
        "scope" : {
          "const" : "group",
          "minLength" : 0,
          "type" : "string"
        }
      },
      "required" : [
        "group_id",
        "scope"
      ],
      "type" : "object"
    }
  ],
  "title" : "PromptScope"
}
