{
  "$id" : "https://lkmc.ch/monkeyspaw/sync-api/schema/GroupMembership.json",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "properties" : {
    "group_id" : {
      "format" : "ulid",
      "pattern" : "^(?:[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])",
      "type" : "string"
    },
    "name" : {
      "maxLength" : 255,
      "minLength" : 1,
      "type" : "string"
    },
    "role" : {
      "$ref" : "Role.json"
    }
  },
  "required" : [
    "group_id",
    "name",
    "role"
  ],
  "title" : "GroupMembership",
  "type" : "object"
}
