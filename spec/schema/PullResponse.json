{
  "$id" : "https://lkmc.ch/monkeyspaw/sync-api/schema/PullResponse.json",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "properties" : {
    "database_id" : {
      "format" : "uuid",
      "pattern" : "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "type" : "string"
    },
    "removed" : {
      "items" : {
        "format" : "scope-key",
        "pattern" : "^(?:(user|group):[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])",
        "type" : "string"
      },
      "type" : "array",
      "uniqueItems" : true
    },
    "scopes" : {
      "items" : {
        "$ref" : "SyncScope.json"
      },
      "minItems" : 1,
      "type" : "array"
    }
  },
  "required" : [
    "database_id",
    "removed",
    "scopes"
  ],
  "title" : "PullResponse",
  "type" : "object",
  "x-syncapi-rules" : [
    "pull-item-budget"
  ]
}
