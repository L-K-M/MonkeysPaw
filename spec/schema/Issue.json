{
  "$id" : "https://lkmc.ch/monkeyspaw/sync-api/schema/Issue.json",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "oneOf" : [
    {
      "additionalProperties" : false,
      "properties" : {
        "code" : {
          "enum" : [
            "field.invalid_boolean",
            "field.invalid_declaration",
            "field.invalid_default",
            "field.invalid_name",
            "field.invalid_options",
            "field.invalid_property",
            "field.reserved_name",
            "field.unknown_type",
            "format.unsupported",
            "front_matter.unclosed",
            "metadata.invalid_format",
            "metadata.invalid_id",
            "metadata.invalid_type",
            "path.absolute",
            "path.backslash",
            "path.control_character",
            "path.empty",
            "path.invalid_extension",
            "path.normalization_failed",
            "path.reserved_groups_prefix",
            "path.segment_dot",
            "path.segment_empty",
            "path.segment_hidden",
            "path.segment_too_long",
            "path.too_long",
            "path.trailing_dot_or_space",
            "prompt.id_mismatch",
            "source.invalid_utf8",
            "source.too_large",
            "template.unbalanced_opener",
            "yaml.anchor_or_alias",
            "yaml.duplicate_key",
            "yaml.invalid",
            "yaml.merge_key",
            "yaml.root_not_mapping",
            "yaml.scalar_not_portable",
            "yaml.tag_not_portable"
          ],
          "type" : "string"
        },
        "location" : {
          "$ref" : "IssueLocation.json"
        },
        "severity" : {
          "const" : "error",
          "type" : "string"
        }
      },
      "required" : [
        "code",
        "severity"
      ],
      "type" : "object"
    },
    {
      "additionalProperties" : false,
      "properties" : {
        "code" : {
          "enum" : [
            "field.unused",
            "metadata.group_private_removed",
            "template.invalid_placeholder"
          ],
          "type" : "string"
        },
        "location" : {
          "$ref" : "IssueLocation.json"
        },
        "severity" : {
          "const" : "warning",
          "type" : "string"
        }
      },
      "required" : [
        "code",
        "severity"
      ],
      "type" : "object"
    }
  ],
  "title" : "Issue"
}
