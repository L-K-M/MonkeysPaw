{
  "$id" : "https://lkmc.ch/monkeyspaw/sync-api/schema/Group.json",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "properties" : {
    "created_at" : {
      "format" : "date-time",
      "minLength" : 0,
      "pattern" : "^(?:(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z)(?![\\s\\S])",
      "type" : "string",
      "x-syncapi-format" : "utc-milliseconds"
    },
    "created_by" : {
      "format" : "ulid",
      "minLength" : 0,
      "pattern" : "^(?:[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])",
      "type" : "string"
    },
    "id" : {
      "format" : "ulid",
      "minLength" : 0,
      "pattern" : "^(?:[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])",
      "type" : "string"
    },
    "name" : {
      "maxLength" : 255,
      "minLength" : 1,
      "type" : "string"
    }
  },
  "required" : [
    "created_at",
    "created_by",
    "id",
    "name"
  ],
  "title" : "Group",
  "type" : "object"
}
