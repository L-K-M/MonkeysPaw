              {
                "path": "Groups/Team/Renamed.md",
                "content": "---\nid: ${prompt.p}\ntitle: Sample\n---\nRemote edit.\n"
              },
              {
                "path": "Conflicts/Team/Sample (conflict b 2026-10-14 0000).md",
                "content": "---\nid: ${prompt.copy}\ntitle: Sample\nx-monkeyspaw-conflict-of: ${prompt.p}\n---\nLocal edit.\n"
