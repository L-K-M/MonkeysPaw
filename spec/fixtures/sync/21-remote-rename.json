      "servers": [
        "main"
      ],
      "users": [
        "alice",
        "bob"
      ],
      "devices": [
        {
          "name": "a",
          "entropy_seed": 1
        },
        {
          "name": "b",
          "entropy_seed": 2
        }
      ],
      "prompts": {
        "p": "01ARZ3NDEKTSV4RRFFQ69G5FAZ",
