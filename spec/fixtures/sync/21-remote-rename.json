        "r": "01ARZ3NDEKTSV4RRFFQ69G5FB1"
      },
      "steps": [
        {
          "action": "login",
          "device": "a",
          "user": "alice",
          "server": "main"
        },
        {
          "action": "http",
          "device": "a",
          "method": "POST",
          "path": "/api/v1/groups",
          "status": 200,
          "body": {
            "name": "Team"
          },
          "bind": {
            "group.team": "/id"
          }
        },
        {
          "action": "http",
          "device": "a",
          "method": "PUT",
          "path": "/api/v1/prompts/${prompt.p}",
          "status": 200,
          "body": {
            "base_rev": 0,
            "scope": "group",
            "path": "Sample.md",
            "content": "---\nid: ${prompt.p}\ntitle: Sample\n---\nBase.\n",
            "group_id": "${group.team}"
          },
          "expected": {
            "/rev": 1
          }
        },
        {
          "action": "sync",
          "device": "a"
        },
        {
          "action": "login",
          "device": "b",
          "user": "alice",
          "server": "main"
        },
        {
          "action": "seed_keyed",
          "device": "b",
          "path": "Groups/Team/Sample.md"
        },
        {
          "action": "http",
          "device": "a",
          "method": "PUT",
          "path": "/api/v1/prompts/${prompt.p}",
          "status": 200,
          "body": {
            "base_rev": 1,
            "scope": "group",
            "path": "Remote.md",
            "content": "---\nid: ${prompt.p}\ntitle: Sample\n---\nBase.\n",
            "group_id": "${group.team}"
          },
          "expected": {
            "/rev": 2
          }
        },
        {
          "action": "reset_metrics",
          "device": "b"
        },
        {
          "action": "sync",
          "device": "b"
        },
        {
          "action": "expect",
          "device": "b",
          "expected": {
            "files": [
              {
                "path": "Groups/Team/Remote.md",
                "content": "---\nid: ${prompt.p}\ntitle: Sample\n---\nBase.\n"
              }
            ],
            "absent": [
              "Groups/Team/Sample.md"
            ],
            "file_count": 1,
            "prompt_count": 1,
            "unique_ids": true,
            "protected_ids": [
              "${prompt.p}"
            ],
            "history_count": 1,
            "state": [
              {
                "id": "${prompt.p}",
                "scope": "group:${group.team}",
                "path": "Remote.md",
                "rev": 2,
                "history": 1,
                "uses": 1,
                "values": {
                  "field": "remembered locally"
                },
                "hash": "bd4fac2e2d50c6850db4dfd67385f0dc99215ecfb3a3f442f6dcf61d9c3069a8"
              }
            ],
            "requests": [
              {
                "method": "PUT",
                "path": "/api/v1/prompts/${prompt.p}",
                "count": 0
              },
              {
                "method": "DELETE",
                "path": "*",
                "count": 0
              },
              {
                "method": "POST",
                "path": "/api/v1/prompts/${prompt.p}/move",
                "count": 0
              }
            ]
          }
        },
        {
          "action": "reset_metrics",
          "device": "b"
        },
        {
          "action": "restart",
          "device": "b"
        },
        {
          "action": "sync",
          "device": "b"
        },
        {
          "action": "expect",
          "device": "b",
          "expected": {
            "writes": 0,
            "file_count": 1,
            "unique_ids": true,
            "history_count": 1,
            "requests": [
              {
                "method": "PUT",
                "path": "*",
                "count": 0
              }
