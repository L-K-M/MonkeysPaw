      "servers": [
        "main"
      ],
      "users": [
        "alice",
        "bob"
      ],
      "devices": [
        {
          "name": "a",
          "entropy_seed": 1
        },
        {
          "name": "b",
          "entropy_seed": 2
        }
      ],
      "prompts": {
        "p": "01ARZ3NDEKTSV4RRFFQ69G5FAZ",
        "q": "01ARZ3NDEKTSV4RRFFQ69G5FB0"
      },
      "steps": [
        {
          "action": "login",
          "device": "a",
          "user": "alice",
          "server": "main"
        },
        {
          "action": "write",
          "device": "a",
          "path": "Sample.md",
          "content": "---\nid: ${prompt.p}\nformat: 2\n---\nFuture.\n"
        },
        {
          "action": "sync",
          "device": "a"
        },
        {
          "action": "expect",
          "device": "a",
          "expected": {
            "status": "syncError",
            "file_count": 1,
            "requests": [
              {
                "method": "PUT",
                "path": "*",
                "count": 0
              }
            ]
          }
        },
        {
          "action": "reset_metrics",
          "device": "a"
        },
        {
          "action": "sync",
          "device": "a"
        },
        {
          "action": "sync",
          "device": "a"
        },
        {
          "action": "expect",
          "device": "a",
          "expected": {
            "status": "syncError",
            "writes": 0,
            "requests": [
              {
                "method": "PUT",
                "path": "*",
                "count": 0
              }
