    {
      "id": "03-edit-vs-pulled-delete",
      "now": "2026-10-14T00:00:00Z",
      "servers": [
        "main"
      ],
      "users": [
        "alice",
        "bob"
      ],
      "devices": [
        {
          "name": "a",
          "entropy_seed": 1
        },
        {
          "name": "b",
          "entropy_seed": 2
        }
      ],
      "prompts": {
        "p": "01ARZ3NDEKTSV4RRFFQ69G5FAZ",
        "q": "01ARZ3NDEKTSV4RRFFQ69G5FB0",
        "r": "01ARZ3NDEKTSV4RRFFQ69G5FB1"
      },
      "steps": [
        {
          "action": "login",
          "device": "a",
          "user": "alice",
          "server": "main"
        },
        {
          "action": "http",
          "device": "a",
          "method": "PUT",
          "path": "/api/v1/prompts/${prompt.p}",
          "status": 200,
          "body": {
            "base_rev": 0,
            "scope": "user",
            "path": "Sample.md",
            "content": "---\nid: ${prompt.p}\ntitle: Sample\n---\nBase.\n"
          },
          "expected": {
            "/rev": 1
          }
        },
        {
          "action": "sync",
          "device": "a"
        },
        {
          "action": "login",
          "device": "b",
          "user": "alice",
          "server": "main"
        },
        {
          "action": "write",
          "device": "b",
          "path": "Sample.md",
          "content": "---\nid: ${prompt.p}\ntitle: Sample\n---\nLocal edit.\n"
        },
        {
          "action": "http",
          "device": "a",
          "method": "DELETE",
          "path": "/api/v1/prompts/${prompt.p}?base_rev=1",
          "status": 200,
          "expected": {
            "/rev": 2
          }
        },
        {
          "action": "reset_metrics",
          "device": "b"
        },
        {
          "action": "sync",
          "device": "b"
        },
        {
          "action": "bind_prompt",
          "device": "b",
          "path": "Conflicts/Personal/Sample (conflict b 2026-10-14 0000).md",
          "name": "copy"
        },
        {
          "action": "expect",
          "device": "b",
          "expected": {
            "files": [
              {
                "path": "Conflicts/Personal/Sample (conflict b 2026-10-14 0000).md",
                "content": "---\nid: ${prompt.copy}\ntitle: Sample\nx-monkeyspaw-conflict-of: ${prompt.p}\n---\nLocal edit.\n"
              }
            ],
            "absent": [
              "Sample.md"
            ],
            "file_count": 1,
            "prompt_count": 1,
            "unique_ids": true,
            "state_absent": [
              "${prompt.p}"
            ],
            "state": [
              {
                "id": "${prompt.copy}",
                "scope": "user:${user.main.alice}",
                "path": "Conflicts/Personal/Sample (conflict b 2026-10-14 0000).md",
                "rev": 1,
                "origin": "conflict_of ${prompt.p}"
              }
            ],
            "requests": [
              {
                "method": "PUT",
                "path": "/api/v1/prompts/${prompt.p}",
                "count": 0
              }
            ]
          }
        },
        {
          "action": "http",
          "device": "a",
          "method": "PUT",
          "path": "/api/v1/prompts/${prompt.p}",
          "status": 410,
          "body": {
            "base_rev": 0,
            "scope": "user",
            "path": "Sample.md",
            "content": "---\nid: ${prompt.p}\ntitle: Sample\n---\nBase.\n"
          }
        },
        {
          "action": "http",
          "device": "a",
          "method": "GET",
          "path": "/api/v1/prompts/${prompt.p}",
          "status": 404
        },
        {
          "action": "reset_metrics",
          "device": "b"
        },
        {
          "action": "restart",
          "device": "b"
        },
        {
          "action": "sync",
          "device": "b"
        },
        {
          "action": "expect",
          "device": "b",
          "expected": {
            "file_count": 1,
            "requests": [
              {
                "method": "PUT",
                "path": "*",
                "count": 0
              }
            ]
          }
        }
      ]
