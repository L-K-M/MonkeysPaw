<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- XML cannot express literal 127/8. HttpTransport checks the request's URL policy before I/O. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
