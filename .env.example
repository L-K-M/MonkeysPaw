# Copy to .env with mode 0600. Never commit .env or put secrets in argv/logs.
# Settings for compose.yaml and the optional proxy-network override.

# Effective container UID/GID, both default 1000. The server refuses UID 0.
# Prepare host bind directories with these owners and mode 0700 before startup.
PUID=1000
PGID=1000
# Local timezone for container tools, default Etc/UTC. Database times stay UTC.
TZ=Etc/UTC
# Host local-disk data/state parent, default ./config (relative to compose.yaml).
CONFIG_DIR=./config

# Host HTTP publication, defaults 127.0.0.1:8790. Keep loopback with a proxy too.
# For an IPv6 loopback bind, use the bracketed address [::1].
# Container listener is fixed at 0.0.0.0:8080 and MONKEYSPAW_DATA_DIR at /data.
MONKEYSPAW_BIND_ADDRESS=127.0.0.1
MONKEYSPAW_PORT=8790
# Public URL for invite links, default http://localhost:8790.
# With HTTPS, set a bare origin such as https://prompts.example.com (no path/query).
# Match the actual external URL when changing the host port or using your proxy.
MONKEYSPAW_PUBLIC_URL=http://localhost:8790

# Bootstrap username, default admin. These inputs apply only to an empty DB.
MONKEYSPAW_ADMIN_USERNAME=admin
# No password default: supply 12+ Unicode scalars, <=72 UTF-8 bytes, no NUL.
# Compose creates /run/secrets/admin_password (0400, PUID/PGID); only its path
# MONKEYSPAW_ADMIN_PASSWORD_FILE enters the server container's environment.
# The plaintext source remains in this private .env. Do not use an env_file.
MONKEYSPAW_ADMIN_PASSWORD=
# Server log level, default info; never enable request/body logging at a proxy.
MONKEYSPAW_LOG_LEVEL=info

# No trusted proxies by default. For Nginx Proxy Manager, set its stable peer
# IP (/32 for IPv4 or /128 for IPv6). Never trust all private networks or 0.0.0.0/0.
MONKEYSPAW_TRUSTED_PROXIES=

# Optional: copy deploy/nginx-proxy-manager/compose.override.yaml.example to
# compose.override.yaml, then set the existing network shared with your proxy.
# Used only by that override; default npm_default. See docs/platform/server.md.
# MONKEYSPAW_PROXY_NETWORK=npm_default
